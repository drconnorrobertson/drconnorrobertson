# Phorest third-party API credentials.
# Issued by Phorest support. Auth scheme is HTTP Basic.
PHOREST_USERNAME=global/your-account@example.com
PHOREST_PASSWORD=your_api_password
PHOREST_BUSINESS_ID=your_business_id

# Phorest API base URL. Default is the global platform host; override only
# if Phorest gives you a different host.
PHOREST_BASE_URL=https://platform.phorest.com/third-party-api-server

# Optional: override branch id used for branch-scoped endpoints.
# If empty, the dashboard will list branches and let you pick.
PHOREST_BRANCH_ID=

# Used to lock down the app behind a single shared password.
# Leave empty to disable auth (NOT recommended in production).
APP_PASSWORD=
